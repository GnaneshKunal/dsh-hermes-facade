{
  "name": "dsh-hermes-facade",
  "version": "0.1.0",
  "type": "module",
  "description": "Drive a local DeepSeek Harness agent from the Hermex iOS app — a host plugin that makes dsh look like a hermes-webui server (HTTP + SSE): sessions, streaming tokens, thinking, tool cards, approvals, clarifications, images, projects.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "hermes",
    "hermex",
    "ios",
    "mobile",
    "hermes-webui",
    "sse",
    "agent",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Gnanesh Kunal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GnaneshKunal/dsh-hermes-facade.git"
  },
  "homepage": "https://github.com/GnaneshKunal/dsh-hermes-facade#readme",
  "bugs": {
    "url": "https://github.com/GnaneshKunal/dsh-hermes-facade/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": ">=22.6"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./standalone": "./scripts/standalone.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "scripts/standalone.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "for f in index.js src/*.mjs scripts/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs",
    "standalone": "node scripts/standalone.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
